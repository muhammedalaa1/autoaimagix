# ---- Server ----
NODE_ENV=development
PORT=4000
# Set to the number of proxies in front of the app (e.g. 1 behind Render/Railway/Nginx).
# Required for correct client IPs in rate limiting. 0 = not behind a proxy.
TRUST_PROXY=0

# ---- Database (Neon) ----
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Token / cookie lifetime in seconds (default 1 day)
JWT_EXPIRES_IN_SECONDS=86400
# "lax" works when frontend and API share a site (e.g. localhost:3000 + localhost:4000).
# Use "none" (requires HTTPS) when they are on different domains.
COOKIE_SAME_SITE=lax

# ---- CORS ----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ---- External API (https://www.weatherapi.com) ----
WEATHER_API_KEY=your-weatherapi-key

# ---- Seed (only used by `npm run db:seed` to create the first admin) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin
